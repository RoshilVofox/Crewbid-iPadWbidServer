                            <textView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" editable="NO" textAlignment="justified" translatesAutoresizingMaskIntoConstraints="NO" id="bIC-wr-6yB">
                                <rect key="frame" x="32" y="84" width="700" height="522"/>
                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                <string key="text">         Your subscription grants you a time-limited service agreement to use our database clients (CrewBid – CrewBidMax – WBidMax) to access and process data. Your subscription time may be 1 month or 12 months. We agree to service the clients to remain functional and we will retain ownership of the software. Your service agreement allows you to use our database clients to download specific data and then to query the data with select (filter) and sort capabilities. This will ultimately result in creating what is called a bid list from the data. In our service agreement, we will maintain the server for functionality and provide an online ability to submit your bid list to Southwest Airlines. This is a database product. You are purchasing this time-limited service agreement as an individual. It is your responsibility to manage your subscription. Any overpayment will give you credit for additional months. Should we sell this service or cease operation, you are not entitled to any refund of months not used.</string>
                                <color key="textColor" systemColor="labelColor"/>
                                <fontDescription key="fontDescription" type="system" pointSize="20"/>
                                <textInputTraits key="textInputTraits" autocapitalizationType="sentences"/>
                            </textView>
                        </subviews>
